# Token de acceso al editor visual (/edit). Sin definir => acceso abierto (solo dev local).
EDIT_TOKEN=

# Secreto de Payload (sesiones del admin). Obligatorio en cualquier entorno no local.
PAYLOAD_SECRET=

# Credenciales del primer usuario admin que crea `npm run seed`.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-1234
